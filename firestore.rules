rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Teacher = signed in with email/password. Student = signed in anonymously.
    function isTeacherAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isStudentAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function mySessionStudentId() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.studentId;
    }
    function myClassName() {
      return get(/databases/$(database)/documents/students/$(mySessionStudentId())).data.className;
    }

    // Which madrasa (tenant) the current signed-in user belongs to.
    // Teacher accounts look this up from /teachers/{uid}; student (anonymous)
    // accounts look this up from their own /sessions/{uid} doc.
    function myMadrasaId() {
      return isTeacherAuth()
        ? get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.madrasaId
        : get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.madrasaId;
    }

    // Maps a teacher's Firebase Auth uid to the madrasa (tenant) they belong
    // to. A teacher can only read/write their own mapping doc, and only the
    // first time (client creates it on first login) — this lets a brand new
    // teacher account bootstrap itself without needing myMadrasaId() first.
    match /teachers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isTeacherAuth() && request.auth.uid == uid;
    }

    // Per-madrasa settings (name, logo, subscription info later).
    match /madrasas/{madrasaId} {
      allow read: if request.auth != null;
      allow write: if isTeacherAuth() && madrasaId == myMadrasaId();
    }

    // Student directory. Read stays open to any signed-in user (teacher or
    // anonymous) because the student-name picker screen needs to list names
    // before a student has logged in / has a session yet. This means, for
    // now, any device can technically list student names/rolls/phone numbers
    // across madrasas via direct API calls (the app UI itself only shows the
    // madrasa it's linked to). Tightening this further requires a public,
    // pre-login way to identify a device's madrasa (e.g. a per-madrasa access
    // code) — worth doing in a later hardening pass once there are multiple
    // real tenants.
    //
    // IMPORTANT: PINs are never stored on this document (see student_pins
    // below) — only a harmless hasPinSet:true/false flag lives here.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    // Student PIN secrets — kept in their own collection so they are never
    // exposed by the open `students` read rule above. No client, not even
    // the student who owns it, can ever read this collection directly.
    // Firestore rules match a PIN server-side (via get()) only at the
    // moment a student's login session is created/renewed, in the
    // `sessions` rule below. Only a teacher of the matching madrasa may
    // set or change a student's PIN.
    match /student_pins/{studentId} {
      allow read: if false;
      allow write: if isTeacherAuth() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.madrasaId == myMadrasaId();
    }

    // Student login session: proves (Firebase Auth uid -> studentId) once a
    // correct PIN has been supplied. The write must include the student's
    // real, current PIN as `pin` in the same request — this rule checks it
    // against student_pins/{studentId} via get(); if it doesn't match (or
    // the student has no PIN set yet), the whole write fails with
    // "permission-denied" and the app shows "ভুল PIN". The submitted `pin`
    // value ends up stored on the session doc itself, but that's harmless:
    // this doc can only ever be read by the same signed-in uid (see allow
    // read below), so it never reaches anyone else.
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isStudentAuth() && request.auth.uid == uid &&
        exists(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)).data.pin == request.resource.data.pin;
    }

    match /attendance/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow write: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
    }

    match /leaves/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
      allow update, delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /results/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /notices/{docId} {
      allow read: if request.auth != null && resource.data.madrasaId == myMadrasaId();
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /diary/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /suggestions/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
      allow update, delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /_ping/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
