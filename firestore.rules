rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= SUPER ADMIN =================
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.get('email', '') == 'mdfakhrul395@gmail.com';
    }

    function isMadrasaActive(id) {
      return id == null ||
        !exists(/databases/$(database)/documents/madrasas/$(id)) ||
        get(/databases/$(database)/documents/madrasas/$(id)).data.get('active', true) != false;
    }

    function isTeacherAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' &&
        (!exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
          (get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('active', true) != false &&
           isMadrasaActive(get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('madrasaId', null))));
    }

    function isStudentAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        (!exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) ||
          isMadrasaActive(get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.get('madrasaId', null)));
    }

    function mySessionStudentId() {
      return exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        ? get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.get('studentId', null)
        : null;
    }

    function myClassName() {
      return (mySessionStudentId() != null &&
              exists(/databases/$(database)/documents/students/$(mySessionStudentId())))
        ? get(/databases/$(database)/documents/students/$(mySessionStudentId())).data.get('className', null)
        : null;
    }

    // আগে: isTeacherAuth() true হলে শর্তহীনভাবে get(teachers/uid) চালাত — কিন্তু
    // isTeacherAuth() নতুন/ডকুমেন্টহীন টিচারের জন্যও true হতে পারে (!exists(...) শাখা),
    // ফলে সেই get() এরর থ্রো করত এবং পুরো কোয়েরিটাই permission-denied দেখাত।
    // এখন exists() আলাদাভাবে চেক করা হচ্ছে, ডকুমেন্ট না থাকলে null রিটার্ন হবে, এরর থ্রো হবে না।
    function myMadrasaId() {
      return isTeacherAuth()
        ? (exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
            ? get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('madrasaId', null)
            : null)
        : (exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
            ? get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.get('madrasaId', null)
            : null);
    }

    function isRequesterAdmin() {
      return isTeacherAuth() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isStudentManager() {
      return isTeacherAuth() && (isRequesterAdmin() || isSuperAdmin());
    }

    match /teachers/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (isTeacherAuth() && resource.data.madrasaId == myMadrasaId() && isRequesterAdmin())
      );
      allow create: if isTeacherAuth() && (
        (isRequesterAdmin() && request.resource.data.madrasaId == myMadrasaId()) ||
        (request.auth.uid == uid &&
         request.resource.data.get('isAdmin', false) == true &&
         request.resource.data.get('active', true) == true &&
         request.resource.data.madrasaId != 'madrasa-001' &&
         !exists(/databases/$(database)/documents/madrasas/$(request.resource.data.madrasaId)))
      );
      allow update: if isTeacherAuth() && (
        (isRequesterAdmin() && resource.data.madrasaId == myMadrasaId()) ||
        (request.auth.uid == uid &&
         request.resource.data.madrasaId == resource.data.madrasaId &&
         request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
         request.resource.data.get('active', true) == resource.data.get('active', true))
      );
      allow delete: if false;
    }

    match /madrasas/{id} {
      allow get: if request.auth != null;
      allow list: if isSuperAdmin();
      allow create: if isTeacherAuth() && id == myMadrasaId();
      allow update: if isSuperAdmin() || (isRequesterAdmin() && id == myMadrasaId());
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if request.auth != null &&
        (!isTeacherAuth() || resource.data.madrasaId == myMadrasaId());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isStudentManager() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isStudentManager() && resource.data.madrasaId == myMadrasaId();
    }

    match /student_pins/{studentId} {
      allow read: if false;
      allow create: if isTeacherAuth() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.madrasaId == myMadrasaId() &&
        (isStudentManager() ||
         get(/databases/$(database)/documents/students/$(studentId)).data.get('hasPinSet', false) == true);
      allow update, delete: if isStudentManager() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.madrasaId == myMadrasaId();
    }

    match /student_contacts/{studentId} {
      allow read: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isStudentManager() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isStudentManager() && resource.data.madrasaId == myMadrasaId();
    }

    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isStudentAuth() && request.auth.uid == uid &&
        isMadrasaActive(request.resource.data.madrasaId) &&
        exists(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)).data.pin == request.resource.data.pin;
    }

    match /attendance/{docId} {
      allow get: if resource == null ||
                    (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                    (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow list: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.get('timeLeftHome', null) ==
          (resource == null ? null : resource.data.get('timeLeftHome', null));
      allow write: if isStudentAuth() && request.resource.data.studentId == mySessionStudentId() &&
        (resource == null || !resource.data.get('timeLeftHome', null)) &&
        request.resource.data.get('status', null) ==
          (resource == null ? null : resource.data.get('status', null)) &&
        request.resource.data.get('reason', null) ==
          (resource == null ? null : resource.data.get('reason', null));
    }

    match /leaves/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
                       (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
      allow update, delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /results/{docId} {
      allow get: if request.auth != null && (
                      resource == null ||
                      (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                      (isStudentAuth() && resource.data.studentId == mySessionStudentId())
                    );
      allow list: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /notices/{docId} {
      allow read: if request.auth != null && resource.data.madrasaId == myMadrasaId();
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /diary/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    // ================= HOMEWORK (হোমওয়ার্ক) =================
    match /homework/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /suggestions/{docId} {
      allow read: if (isRequesterAdmin() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if isStudentAuth() &&
        request.resource.data.studentId == mySessionStudentId() &&
        request.resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.keys().hasOnly(['madrasaId', 'studentId', 'text', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
      allow update: if isRequesterAdmin() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId;
      allow delete: if isRequesterAdmin() && resource.data.madrasaId == myMadrasaId();
    }

    match /fees_monthly/{docId} {
      allow get: if resource == null ||
                    (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                    (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow list: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /fees_onetime/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    // ================= USAGE TRACKER (ব্যবহারের হিসাব) =================
    // শুধু isAdmin=true থাকা শিক্ষক বা সুপার-অ্যাডমিন এই সংখ্যা দেখতে পারবেন।
    // যেকোনো সাইন-ইন করা শিক্ষক/ছাত্র লিখতে পারবে (তারাই read/write তৈরি করে),
    // কিন্তু শুধু নির্দিষ্ট সংখ্যার ফিল্ড ছাড়া আর কিছু লেখা যাবে না, আর সংখ্যা কখনো
    // পেছনের দিকে (কমে) যাবে না।
    match /usage_stats/{date} {
      allow read: if isRequesterAdmin() || isSuperAdmin();

      allow write: if request.auth != null &&
        date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['reads', 'writes', 'deletes', 'lastUpdated']) &&
        request.resource.data.reads is number && request.resource.data.reads >= 0 &&
        request.resource.data.writes is number && request.resource.data.writes >= 0 &&
        request.resource.data.deletes is number && request.resource.data.deletes >= 0 &&
        (!('reads' in resource.data) || request.resource.data.reads >= resource.data.reads) &&
        (!('writes' in resource.data) || request.resource.data.writes >= resource.data.writes) &&
        (!('deletes' in resource.data) || request.resource.data.deletes >= resource.data.deletes);
    }

    match /_ping/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
