rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // নিরাপত্তা হালনাগাদ (Oct 21): মূল পরিবর্তনগুলো
    // ১) অ্যাডমিন নিজের teacher ডকের madrasaId বদলে অন্য মাদ্রাসার অ্যাডমিন হতে পারত — বন্ধ
    // ২) শিক্ষার্থীর session-এ madrasaId নিজে বসিয়ে বাতিল মাদ্রাসা/অন্য মাদ্রাসার নোটিশে ঢোকা যেত — বন্ধ
    // ৩) অপ্রকাশিত রেজাল্ট শিক্ষার্থী কনসোল থেকে পড়তে পারত — বন্ধ
    // ৪) শিক্ষার্থী নিজের ছুটি "approved" করে জমা দিতে পারত — বন্ধ
    // ৫) শিক্ষার্থী হাজিরা ডকের date/madrasaId বদলে রেকর্ড সরাতে পারত — এখন শুধু timeLeftHome
    // ৬) এক মাদ্রাসার অ্যাডমিন/শিক্ষক অন্য মাদ্রাসার ডক (হাজিরা, বেতন, রেজাল্ট, ফোন, শিক্ষার্থী) ওভাররাইট করতে পারত — বন্ধ
    // ৭) কোড দিয়ে যোগদান (pending) নিয়মে তৈরির অনুমতি ছিল না, আর pending শিক্ষক সার্ভারে আটকানো ছিল না — ঠিক করা
    // ======================================================================

    // ================= SUPER ADMIN =================
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.get('email', '') == 'mdfakhrul395@gmail.com';
    }

    function isMadrasaActive(id) {
      return id == null ||
        !exists(/databases/$(database)/documents/madrasas/$(id)) ||
        get(/databases/$(database)/documents/madrasas/$(id)).data.get('active', true) != false;
    }

    // ইমেইল/পাসওয়ার্ড দিয়ে সাইন-ইন করা যে কেউ (teacher ডক থাকুক বা না থাকুক)
    function isPasswordUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function myTeacherDoc() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    // এখন teacher ডক থাকতেই হবে; সক্রিয়, অনুমোদিত (pending নয়) এবং মাদ্রাসা সক্রিয় হতে হবে
    function isTeacherAuth() {
      return isPasswordUser() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        myTeacherDoc().get('active', true) != false &&
        myTeacherDoc().get('pending', false) != true &&
        isMadrasaActive(myTeacherDoc().get('madrasaId', null));
    }

    function isStudentAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        (!exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) ||
          isMadrasaActive(get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.get('madrasaId', null)));
    }

    function mySessionStudentId() {
      return exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        ? get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.get('studentId', null)
        : null;
    }

    function myClassName() {
      return (mySessionStudentId() != null &&
              exists(/databases/$(database)/documents/students/$(mySessionStudentId())))
        ? get(/databases/$(database)/documents/students/$(mySessionStudentId())).data.get('className', null)
        : null;
    }

    function myMadrasaId() {
      return isTeacherAuth()
        ? myTeacherDoc().get('madrasaId', null)
        : ((request.auth != null && exists(/databases/$(database)/documents/sessions/$(request.auth.uid)))
            ? get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.get('madrasaId', null)
            : null);
    }

    function isRequesterAdmin() {
      return isTeacherAuth() && myTeacherDoc().get('isAdmin', false) == true;
    }

    function isStudentManager() {
      return isTeacherAuth() && (isRequesterAdmin() || isSuperAdmin());
    }

    // শিক্ষার্থী আছে এবং আমার মাদ্রাসার
    function studentInMyMadrasa(sid) {
      return sid is string &&
        get(/databases/$(database)/documents/students/$(sid)).data.madrasaId == myMadrasaId();
    }

    // ================= শ্রেণি শিক্ষক =================
    function myClassTeacherOf() {
      return myTeacherDoc().get('classTeacherOf', '');
    }

    function isMyClassStudent(studentId) {
      return isTeacherAuth() &&
        myClassTeacherOf() != '' &&
        studentInMyMadrasa(studentId) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.get('className', null) == myClassTeacherOf();
    }

    function canEditResultOf(studentId) {
      return studentInMyMadrasa(studentId) && (isStudentManager() || isMyClassStudent(studentId));
    }

    // আগে থেকেই থাকা ডকের জন্য (ডকের madrasaId আলাদাভাবে মেলানো হয়) — বাড়তি get লাগে না
    function canModifyResultOf(studentId) {
      return isStudentManager() || isMyClassStudent(studentId);
    }

    function validPin() {
      return request.resource.data.pin is string &&
        request.resource.data.pin.matches('^[0-9]{4,8}$');
    }

    // ================= TEACHERS =================
    match /teachers/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (isTeacherAuth() && resource.data.madrasaId == myMadrasaId() && isRequesterAdmin())
      );

      allow create: if
        // (১) অ্যাডমিন নিজের মাদ্রাসায় শিক্ষক যোগ করছেন
        (isRequesterAdmin() && request.resource.data.madrasaId == myMadrasaId()) ||
        // (২) নতুন মাদ্রাসা নিবন্ধন: নিজে নিজের অ্যাডমিন, madrasaId অবশ্যই নতুন (m_xxx_yyy ছাঁচে) ও অব্যবহৃত
        (isPasswordUser() && request.auth.uid == uid &&
         request.resource.data.get('isAdmin', false) == true &&
         request.resource.data.get('active', true) == true &&
         request.resource.data.get('pending', false) == false &&
         !('classTeacherOf' in request.resource.data) &&
         request.resource.data.madrasaId is string &&
         request.resource.data.madrasaId.matches('^m_[a-z0-9]+_[a-z0-9]+$') &&
         !exists(/databases/$(database)/documents/madrasas/$(request.resource.data.madrasaId))) ||
        // (৩) কোড দিয়ে যোগদান: সাধারণ শিক্ষক, অনুমোদনের অপেক্ষায় (pending) — pending থাকা পর্যন্ত কোনো ডেটায় ঢুকতে পারবে না
        (isPasswordUser() && request.auth.uid == uid &&
         request.resource.data.get('isAdmin', false) == false &&
         request.resource.data.get('active', true) == true &&
         request.resource.data.get('pending', false) == true &&
         !('classTeacherOf' in request.resource.data) &&
         request.resource.data.madrasaId is string &&
         exists(/databases/$(database)/documents/madrasas/$(request.resource.data.madrasaId)) &&
         isMadrasaActive(request.resource.data.madrasaId));

      allow update: if isTeacherAuth() && (
        // অ্যাডমিন নিজের মাদ্রাসার শিক্ষক বদলাতে পারে, কিন্তু madrasaId কখনো বদলাতে পারবে না
        (isRequesterAdmin() && resource.data.madrasaId == myMadrasaId() &&
         request.resource.data.madrasaId == resource.data.madrasaId) ||
        (request.auth.uid == uid &&
         request.resource.data.madrasaId == resource.data.madrasaId &&
         request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false) &&
         request.resource.data.get('active', true) == resource.data.get('active', true) &&
         request.resource.data.get('classTeacherOf', '') == resource.data.get('classTeacherOf', '') &&
         request.resource.data.get('pending', false) == resource.data.get('pending', false))
      );
      allow delete: if false;
    }

    // ================= MADRASAS + প্যাকেজ =================
    // প্যাকেজ ফিল্ড, finalResultEnabled ও active শুধু সুপার অ্যাডমিন লিখতে পারেন
    match /madrasas/{id} {
      allow get: if request.auth != null;
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() ||
        (isTeacherAuth() && id == myMadrasaId() &&
         !request.resource.data.keys().hasAny(['plan', 'planExpiry', 'planUpdatedAt', 'studentLimit', 'teacherLimit', 'planPrice', 'finalResultEnabled', 'active']) &&
         (!('trialEndsAt' in request.resource.data) ||
          (request.resource.data.trialEndsAt is number &&
           request.resource.data.trialEndsAt <= request.time.toMillis() + 2678400000)));
      allow update: if isSuperAdmin() ||
        (isRequesterAdmin() && id == myMadrasaId() &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planExpiry', 'planUpdatedAt', 'trialEndsAt', 'studentLimit', 'teacherLimit', 'planPrice', 'finalResultEnabled', 'active']));
      allow delete: if false;
    }

    // ================= STUDENTS =================
    // (জানা সীমাবদ্ধতা) নাম/রোল/শ্রেণি এখনও লগইনের আগে সবাই পড়তে পারে — পুরো সমাধানে Blaze প্ল্যান লাগবে
    match /students/{studentId} {
      allow read: if request.auth != null &&
        (!isTeacherAuth() || resource.data.madrasaId == myMadrasaId());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isTeacherAuth() &&
        resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId &&
        (isStudentManager() ||
         (myClassTeacherOf() != '' &&
          resource.data.get('className', null) == myClassTeacherOf() &&
          request.resource.data.get('className', null) == resource.data.get('className', null)));
      allow delete: if isStudentManager() && resource.data.madrasaId == myMadrasaId();
    }

    match /student_pins/{studentId} {
      allow read: if false;
      allow create: if isTeacherAuth() && studentInMyMadrasa(studentId) && validPin() &&
        (isStudentManager() || isMyClassStudent(studentId) ||
         get(/databases/$(database)/documents/students/$(studentId)).data.get('hasPinSet', false) == true);
      allow update: if (isStudentManager() || isMyClassStudent(studentId)) &&
        studentInMyMadrasa(studentId) && validPin();
      allow delete: if isStudentManager() && studentInMyMadrasa(studentId);
    }

    match /student_contacts/{studentId} {
      allow read: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId() &&
        studentInMyMadrasa(studentId);
      allow update: if (isStudentManager() || isMyClassStudent(studentId)) &&
        resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isStudentManager() && resource.data.madrasaId == myMadrasaId();
    }

    // শিক্ষার্থীর লগইন সেশন: PIN মিলতে হবে, আর session-এর madrasaId অবশ্যই শিক্ষার্থীর নিজের মাদ্রাসার হতে হবে
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isStudentAuth() && request.auth.uid == uid &&
        request.resource.data.studentId is string &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
        request.resource.data.madrasaId ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.madrasaId &&
        isMadrasaActive(request.resource.data.madrasaId) &&
        exists(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)).data.pin == request.resource.data.pin;
    }

    // ================= ATTENDANCE =================
    match /attendance/{docId} {
      allow get: if request.auth != null && (
                    resource == null ||
                    (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                    (isStudentAuth() && resource.data.studentId == mySessionStudentId()));
      allow list: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());

      // শিক্ষক: নতুন ডকের আইডি অবশ্যই "শিক্ষার্থী-আইডি_তারিখ" ছাঁচে এবং শিক্ষার্থী নিজের মাদ্রাসার (batch-chunk.js ব্যাচ ১০টি করে ভাগ করে, তাই ২০-র সীমা পার হয় না)
      allow create: if isTeacherAuth() &&
        request.resource.data.madrasaId == myMadrasaId() &&
        studentInMyMadrasa(request.resource.data.studentId) &&
        docId.matches(request.resource.data.studentId + '_.*') &&
        request.resource.data.get('timeLeftHome', null) == null;
      allow update: if isTeacherAuth() &&
        resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.get('timeLeftHome', null) == resource.data.get('timeLeftHome', null);
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();

      // শিক্ষার্থী: শুধু নিজের "বের হওয়ার সময়", একবারই
      allow create: if isStudentAuth() &&
        request.resource.data.keys().hasOnly(['studentId', 'date', 'madrasaId', 'timeLeftHome']) &&
        request.resource.data.studentId == mySessionStudentId() &&
        request.resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.date is string && request.resource.data.date.size() == 10 &&
        docId == request.resource.data.studentId + '_' + request.resource.data.date &&
        request.resource.data.timeLeftHome is string && request.resource.data.timeLeftHome.size() <= 8;
      allow update: if isStudentAuth() &&
        resource.data.studentId == mySessionStudentId() &&
        (resource.data.get('timeLeftHome', null) == null || resource.data.get('timeLeftHome', '') == '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeLeftHome']) &&
        request.resource.data.timeLeftHome is string && request.resource.data.timeLeftHome.size() <= 8;
    }

    // ================= LEAVES =================
    match /leaves/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId() &&
                        studentInMyMadrasa(request.resource.data.studentId)) ||
                       (isStudentAuth() &&
                        request.resource.data.studentId == mySessionStudentId() &&
                        request.resource.data.madrasaId == myMadrasaId() &&
                        request.resource.data.get('status', null) == 'pending' &&
                        request.resource.data.reason is string &&
                        request.resource.data.reason.size() <= 1000);
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId;
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    // ================= RESULTS =================
    // শিক্ষার্থী শুধু নিজের "প্রকাশিত" রেজাল্ট দেখতে পারবে (আগে প্রকাশের শর্ত শুধু অ্যাপে ছিল)
    match /results/{docId} {
      allow get: if request.auth != null && (
                      resource == null ||
                      (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                      (isStudentAuth() && resource.data.studentId == mySessionStudentId() &&
                       resource.data.published == true)
                    );
      allow list: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId() &&
                      resource.data.published == true);
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId() &&
        docId.matches(request.resource.data.studentId + '_.*') &&
        canEditResultOf(request.resource.data.studentId);
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId &&
        request.resource.data.studentId == resource.data.studentId &&
        canModifyResultOf(resource.data.studentId);
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        canModifyResultOf(resource.data.studentId);
    }

    // ================= নোটিশ / ডায়েরি / হোমওয়ার্ক / পরীক্ষার রুটিন =================
    // create ও update আলাদা: update-এ ডকের আগের madrasaId-ও নিজের হতে হবে
    match /notices/{docId} {
      allow read: if request.auth != null && resource.data.madrasaId == myMadrasaId();
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /diary/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /homework/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /examRoutines/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /suggestions/{docId} {
      allow read: if (isRequesterAdmin() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if isStudentAuth() &&
        request.resource.data.studentId == mySessionStudentId() &&
        request.resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.keys().hasOnly(['madrasaId', 'studentId', 'text', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000;
      allow update: if isRequesterAdmin() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId;
      allow delete: if isRequesterAdmin() && resource.data.madrasaId == myMadrasaId();
    }

    // ================= FEES =================
    match /fees_monthly/{docId} {
      allow get: if request.auth != null && (
                    resource == null ||
                    (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                    (isStudentAuth() && resource.data.studentId == mySessionStudentId()));
      allow list: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId() &&
        studentInMyMadrasa(request.resource.data.studentId) &&
        docId.matches(request.resource.data.studentId + '_.*');
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /fees_onetime/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
                     (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId() &&
        studentInMyMadrasa(request.resource.data.studentId);
      allow update: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId() &&
        request.resource.data.madrasaId == resource.data.madrasaId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    // শ্রেণিভিত্তিক / ব্যক্তিগত নির্ধারিত মাসিক বেতন (fees-quick.js)। ডকের আইডি = মাদ্রাসার আইডি
    match /fee_defaults/{id} {
      allow read: if isTeacherAuth() && id == myMadrasaId();
      allow create, update: if isTeacherAuth() && id == myMadrasaId() &&
        request.resource.data.madrasaId == myMadrasaId();
      allow delete: if false;
    }

    // ================= PAYMENTS =================
    match /payment_settings/{id} {
      allow read: if isRequesterAdmin() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /payment_requests/{reqId} {
      allow read: if isSuperAdmin() ||
                     (isRequesterAdmin() && resource.data.madrasaId == myMadrasaId());
      allow create: if isRequesterAdmin() &&
        request.resource.data.keys().hasOnly(['madrasaId', 'madrasaName', 'plan', 'months', 'amount', 'senderNumber', 'trxId', 'status', 'createdAt']) &&
        request.resource.data.madrasaId == myMadrasaId() &&
        reqId == request.resource.data.madrasaId + '_' + request.resource.data.trxId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.plan is string && request.resource.data.plan.size() <= 20 &&
        request.resource.data.months is number && request.resource.data.months >= 1 && request.resource.data.months <= 24 &&
        request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000 &&
        request.resource.data.senderNumber is string && request.resource.data.senderNumber.size() >= 11 && request.resource.data.senderNumber.size() <= 14 &&
        request.resource.data.trxId is string && request.resource.data.trxId.size() >= 6 && request.resource.data.trxId.size() <= 20 &&
        request.resource.data.madrasaName is string && request.resource.data.madrasaName.size() <= 80 &&
        request.resource.data.createdAt is number;
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ================= USAGE TRACKER =================
    match /usage_stats/{date} {
      allow read: if isRequesterAdmin() || isSuperAdmin();

      allow write: if request.auth != null &&
        date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.keys().hasOnly(['reads', 'writes', 'deletes', 'lastUpdated']) &&
        request.resource.data.reads is number && request.resource.data.reads >= 0 && request.resource.data.reads <= 100000000 &&
        request.resource.data.writes is number && request.resource.data.writes >= 0 && request.resource.data.writes <= 100000000 &&
        request.resource.data.deletes is number && request.resource.data.deletes >= 0 && request.resource.data.deletes <= 100000000 &&
        (resource == null || (
          (!('reads' in resource.data) || request.resource.data.reads >= resource.data.reads) &&
          (!('writes' in resource.data) || request.resource.data.writes >= resource.data.writes) &&
          (!('deletes' in resource.data) || request.resource.data.deletes >= resource.data.deletes)
        ));
    }

    match /_ping/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
