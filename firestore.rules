rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Teacher = signed in with email/password AND not deactivated.
    // Student = signed in anonymously.
    //
    // The `active != false` check is what makes "নিষ্ক্রিয় করুন" (deactivate)
    // in the শিক্ষকগণ screen instantly revoke a teacher's access EVERYWHERE
    // in the app (students, attendance, results, notices, diary, fees,
    // etc.) — every single rule in this file that grants teacher access
    // goes through isTeacherAuth(), so this one check covers all of them.
    // A doc with no `active` field at all (every teacher created before
    // this update) is treated as active — `undefined != false` is true —
    // so nothing changes for existing accounts until an admin explicitly
    // deactivates one.
    function isTeacherAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active != false;
    }
    function isStudentAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function mySessionStudentId() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.studentId;
    }
    function myClassName() {
      return get(/databases/$(database)/documents/students/$(mySessionStudentId())).data.className;
    }

    // Which madrasa (tenant) the current signed-in user belongs to.
    // Teacher accounts look this up from /teachers/{uid}; student (anonymous)
    // accounts look this up from their own /sessions/{uid} doc.
    function myMadrasaId() {
      return isTeacherAuth()
        ? get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.madrasaId
        : get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.madrasaId;
    }

    // Whether the current signed-in teacher has isAdmin:true on their own
    // teachers/{uid} doc — used by the শিক্ষকগণ (multi-admin) feature to
    // gate adding/removing other teacher accounts and toggling admin status.
    function isRequesterAdmin() {
      return isTeacherAuth() &&
        get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.isAdmin == true;
    }

    // Maps a teacher's Firebase Auth uid to the madrasa (tenant) they belong
    // to, plus their isAdmin/active status.
    //
    // - Any signed-in teacher can read their OWN doc (to resolve their
    //   madrasaId/isAdmin/active status on login).
    // - An admin teacher can read/list ALL teacher docs in their own
    //   madrasa (needed for the শিক্ষকগণ management screen).
    // - Self-CREATE (bootstrap on first login, before any admin/teacher
    //   docs exist for this device) is still allowed so an existing
    //   single-teacher madrasa keeps working exactly as before — but it
    //   can never self-grant isAdmin or active:false, only a real admin
    //   (or manual Firebase Console edit, for the very first admin) can
    //   set those.
    // - An admin can create a new teacher's doc (right after creating
    //   their Firebase Auth account from the শিক্ষকগণ screen) or update
    //   any teacher's doc in their madrasa (promote/demote admin,
    //   activate/deactivate).
    // - A non-admin teacher may still update their own doc (e.g. re-save
    //   their email), but may never change their own isAdmin or active
    //   fields that way — only an admin, via the branch above, can do
    //   that.
    match /teachers/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (isTeacherAuth() && resource.data.madrasaId == myMadrasaId() && isRequesterAdmin())
      );

      allow create: if isTeacherAuth() && (
        (request.auth.uid == uid &&
          (request.resource.data.isAdmin == false || !('isAdmin' in request.resource.data)) &&
          (request.resource.data.active == true || !('active' in request.resource.data))) ||
        (isRequesterAdmin() && request.resource.data.madrasaId == myMadrasaId())
      );

      allow update: if isTeacherAuth() && (
        (isRequesterAdmin() && resource.data.madrasaId == myMadrasaId()) ||
        (request.auth.uid == uid &&
          request.resource.data.madrasaId == resource.data.madrasaId &&
          request.resource.data.isAdmin == resource.data.isAdmin &&
          request.resource.data.active == resource.data.active)
      );

      allow delete: if false; // deactivate (active:false) instead of deleting — see comment above isTeacherAuth()
    }

    // Per-madrasa settings (name, logo, subscription info later).
    match /madrasas/{madrasaId} {
      allow read: if request.auth != null;
      allow write: if isTeacherAuth() && madrasaId == myMadrasaId();
    }

    // Student directory. Read stays open to any signed-in user (teacher or
    // anonymous) because the student-name picker screen needs to list names
    // before a student has logged in / has a session yet. This means, for
    // now, any device can technically list student names/rolls across
    // madrasas via direct API calls (the app UI itself only shows the
    // madrasa it's linked to). Tightening this further requires a public,
    // pre-login way to identify a device's madrasa (e.g. a per-madrasa access
    // code) — worth doing in a later hardening pass once there are multiple
    // real tenants.
    //
    // IMPORTANT: PINs are never stored on this document (see student_pins
    // below), and phone/WhatsApp info is now kept in the separate
    // teacher-only student_contacts collection below — this doc only holds
    // non-sensitive fields (name/roll/className/hasPinSet).
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    // Student PIN secrets — kept in their own collection so they are never
    // exposed by the open `students` read rule above. No client, not even
    // the student who owns it, can ever read this collection directly.
    // Firestore rules match a PIN server-side (via get()) only at the
    // moment a student's login session is created/renewed, in the
    // `sessions` rule below. Only a teacher of the matching madrasa may
    // set or change a student's PIN.
    match /student_pins/{studentId} {
      allow read: if false;
      allow write: if isTeacherAuth() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.madrasaId == myMadrasaId();
    }

    // Student phone number / WhatsApp flag — kept in their own collection,
    // separate from the open-read `students` collection above, so this data
    // is only ever readable by a teacher of the same madrasa (never by
    // students, never by other madrasas' devices). Students never need to
    // read this themselves.
    match /student_contacts/{studentId} {
      allow read: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    // Student login session: proves (Firebase Auth uid -> studentId) once a
    // correct PIN has been supplied. The write must include the student's
    // real, current PIN as `pin` in the same request — this rule checks it
    // against student_pins/{studentId} via get(); if it doesn't match (or
    // the student has no PIN set yet), the whole write fails with
    // "permission-denied" and the app shows "ভুল PIN". The submitted `pin`
    // value ends up stored on the session doc itself, but that's harmless:
    // this doc can only ever be read by the same signed-in uid (see allow
    // read below), so it never reaches anyone else.
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isStudentAuth() && request.auth.uid == uid &&
        exists(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/student_pins/$(request.resource.data.studentId)).data.pin == request.resource.data.pin;
    }

    // Attendance: one doc per student per date (docId = studentId_date).
    // For most students on a given day, this doc doesn't exist yet until
    // the teacher marks them — so, same as fees_monthly below, `resource`
    // is null on that read and `resource == null` must be allowed through
    // first (there's no data to protect on a doc that doesn't exist). Without
    // this, reading resource.data.madrasaId on a null resource made the
    // whole read fail as permission-denied, which is what caused the
    // উপস্থিতি tab's student cards to get stuck on "লোড হচ্ছে..." forever.
    match /attendance/{docId} {
      allow read: if resource == null ||
        (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow write: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
    }

    match /leaves/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
      allow update, delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /results/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /notices/{docId} {
      allow read: if request.auth != null && resource.data.madrasaId == myMadrasaId();
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /diary/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.madrasaId == myMadrasaId() && resource.data.className == myClassName());
      allow write: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
    }

    match /suggestions/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create: if (isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && request.resource.data.studentId == mySessionStudentId());
      allow update, delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    // Monthly fee (মাসিক বেতন): one paid/due entry per student per month.
    // Doc may not yet exist when a teacher's UI first checks a given
    // student+month (same as attendance), so `resource == null` is allowed
    // through on read — there is no data to protect on a doc that doesn't
    // exist yet.
    match /fees_monthly/{docId} {
      allow read: if resource == null ||
        (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    // One-time fees (ভর্তি/পরীক্ষা ফি ইত্যাদি) — only a teacher can add,
    // edit status, or delete; a student may only read their own.
    match /fees_onetime/{docId} {
      allow read: if (isTeacherAuth() && resource.data.madrasaId == myMadrasaId()) ||
        (isStudentAuth() && resource.data.studentId == mySessionStudentId());
      allow create, update: if isTeacherAuth() && request.resource.data.madrasaId == myMadrasaId();
      allow delete: if isTeacherAuth() && resource.data.madrasaId == myMadrasaId();
    }

    match /_ping/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
